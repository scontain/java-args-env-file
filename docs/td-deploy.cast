[11.874005, "o", "\r\n---\r\napiVersion: apps/v1\r\nkind: Deployment\r\nmetadata:\r\n  name: java-cli-env-reader\r\nspec:\r\n  replicas: 1\r\n  selector:\r\n    matchLabels:\r\n      app: java-cli-env-reader\r\n  template:\r\n    metadata:\r\n      labels:\r\n        app: java-cli-env-reader\r\n    spec:\r\n      containers:\r\n      - name: java-cli-env\r\n        image: registry.scontain.com/workshop/java-cli-env-reader:96cebfdd2b7c823967d3b84ef11f6590e3db86418c93cabb28c4840ac1256d28-scone\r\n        imagePullPolicy: Always\r\n        command:\r\n        - /opt/java/openjdk/bin/java\r\n        env:\r\n        - name: SCONE_CONFIG_ID\r\n          value: jqftte95uy-session-k8s-scone/deployment-java-cli-env-reader/java-cli-env-reader-cas-default/java-cli-env\r\n        - name: SCONE_CAS_ADDR\r\n          value: cas.default\r\n        - name: SCONE_VERSION\r\n          value: '1'\r\n        - name: SCONE_LOG\r\n          value: FATAL\r\n        - name: SCONE_HEAP\r\n          value: 2G\r\n        - name: SCONE_ALLOW_DLOPEN\r\n          value: '2'\r\n        - name: SCONE_EDMM_MODE\r\n          value: auto\r\n        - name: SCONE_SYSLIBS\r\n          value: '1'\r\n        - name: SCONE_LAS_ADDR\r\n          valueFrom:\r\n            fieldRef:\r\n              apiVersion: v1\r\n              fieldPath: status.hostIP\r\n        ports:\r\n        - containerPort: 9999\r\n          name: metrics\r\n          protocol: TCP\r\n        resources:\r\n          limits:\r\n            sgx.k8s.io/sgx: 1\r\n      imagePullSecrets:\r\n      - name: sconeapps\r\n      volumes: []\r\n\r\n---\r\napiVersion: cas.scone.cloud/v1beta1\r\nkind: EncryptedPolicy\r\nmetadata:\r\n  annotations: \r\n    hash: 2344fbf36eba1fd0d54b9766bb26177813bc8bcf7712672595c88acd8562a127\r\n  name: encryptedpolicy-jqftte95uy-session-k8s-scone\r\nspec:\r\n  casAddress: https://cas.default:8081\r\n  policy: \r\n  encryptionKey: 0ff2b45adf8f9394de4d9e16e826ed750255fa81931a05bac120e9b72136534d\r\n    \r\n---\r\n