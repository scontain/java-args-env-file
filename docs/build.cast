[49.480888, "o", "apiVersion: apps/v1\r\nkind: Deployment\r\nmetadata:\r\n  name: java-cli-env-reader\r\nspec:\r\n  replicas: 1\r\n  selector:\r\n    matchLabels:\r\n      app: java-cli-env-reader\r\n  template:\r\n    metadata:\r\n      labels:\r\n        app: java-cli-env-reader\r\n    spec:\r\n      containers:\r\n        - name: java-cli-env\r\n          image: \"registry.scontain.com/workshop/java-cli-env-reader@sha256:96cebfdd2b7c823967d3b84ef11f6590e3db86418c93cabb28c4840ac1256d28\"\r\n          imagePullPolicy: Always\r\n          command: [\"/opt/java/openjdk/bin/java\", \"Main\"]\r\n          args: [\"arg1\", \"arg2\"]\r\n          ports:\r\n          - containerPort: 9999\r\n            name: metrics\r\n            protocol: TCP\r\n          volumeMounts:\r\n            - name: config-volume\r\n              mountPath: /config/configs.yaml\r\n              subPath: configs.yaml\r\n            - name: secret-volume\r\n              mountPath: /config/secrets\r\n              subPath: secrets\r\n      imagePullSecrets:\r\n        - name: sconeapps\r\n      volumes:\r\n        - name: config-volume\r\n          configMap:\r\n            name: java-cli-env-config\r\n        - name: secret-volume\r\n          secret:\r\n            secretName: java-cli-env-secret\r\n"]
