[8.32478, "o", "Usage: ./scripts/build.sh [OPTIONS]\r\n\r\nBuild and push Docker image, and generate Kubernetes manifests from templates.\r\n\r\nOptions:\r\n  --repo <repo>         Docker repository (default: 'registry.scontain.com/workshop/java-cli-env-reader')\r\n  --tag <tag>           Docker image tag (default: 'latest')\r\n  --pullsecret <name>   Kubernetes imagePullSecret name (default: 'sconeapps')\r\n  --namespace, -n <ns>  Kubernetes namespace to inject into manifests (default: '')\r\n  --no-cache            Disable Docker build cache (force image rebuild)\r\n  --bundle-manifests    Bundle the Manifests into one yaml file ('')\r\n  --alpine              Use Alpine base image for the application image\r\n  --help                Show this help message\r\n\r\n\r\nExamples:\r\n  ./scripts/build.sh\r\n  ./scripts/build.sh --repo ghcr.io/me/myapp --tag v1.2.3 --pullsecret mysecret -n devspace\r\n"]
