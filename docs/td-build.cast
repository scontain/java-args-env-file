[24.515461, "o", "\u001b[90m[\u001b[0m2025-09-16T06:30:13Z \u001b[32mINFO \u001b[0m k8s_scone::register\u001b[90m]\u001b[0m Registering image...\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:13Z \u001b[32mINFO \u001b[0m k8s_scone::register\u001b[90m]\u001b[0m Storage file arg-env.json does not exist. Initializing an empty map: No such file or directory (os error 2)\r\n"]
[24.56897, "o", "\u001b[90m[\u001b[0m2025-09-16T06:30:13Z \u001b[32mINFO \u001b[0m k8s_scone::tools::docker\u001b[90m]\u001b[0m 'sha256:122817141fa2bfc3873dedf1a0380ea9aeb8d5e5e48b647695f63d4e774539d6'\r\n"]
[24.626685, "o", "\u001b[90m[\u001b[0m2025-09-16T06:30:13Z \u001b[32mINFO \u001b[0m k8s_scone::tools::docker\u001b[90m]\u001b[0m 'sha256:122817141fa2bfc3873dedf1a0380ea9aeb8d5e5e48b647695f63d4e774539d6'\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:13Z \u001b[32mINFO \u001b[0m k8s_scone::register\u001b[90m]\u001b[0m Processing: protected=registry.scontain.com/workshop/java-cli-env-reader:96cebfdd2b7c823967d3b84ef11f6590e3db86418c93cabb28c4840ac1256d28, unprotected: eclipse-temurin:17-jre\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:13Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Parsing SCONE environment variables... []\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:13Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Parsing SCONE environment variables... SconeArgs { stack: \"2MB\", minheap: \"8MB\", heap: \"6GB\", tcs: 8, key: None, builtin_signer: false, mprotect: true, dlopen: ProtectFiles, fork: false, sconify: true, syslibs: true, extensions: None, production: true, xfrm: \"avx,avx512\", miscselect: \"exinfo\", isvsvn: 0, isvprodid: 0, env_passthrough: false }\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:13Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Starting the build...\r\n"]
[25.587149, "o", "\u001b[90m[\u001b[0m2025-09-16T06:30:14Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Checking if image 'registry.scontain.com/workshop/java-cli-env-reader:96cebfdd2b7c823967d3b84ef11f6590e3db86418c93cabb28c4840ac1256d28' is musl-based\r\n"]
[28.603112, "o", "\u001b[90m[\u001b[0m2025-09-16T06:30:17Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Image 'registry.scontain.com/workshop/java-cli-env-reader:96cebfdd2b7c823967d3b84ef11f6590e3db86418c93cabb28c4840ac1256d28' is not musl-based (assuming glibc)\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:17Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Dockefile content: \r\n    # Base Image\r\n    FROM registry.scontain.com/public-images/glibc:2.39-v3 AS glibc\r\n    FROM registry.scontain.com/scone.cloud/scone-deb-pkgs:5.10.0-rc.5 AS sconetools\r\n    \r\n    FROM registry.scontain.com/scone.cloud/sconecli:5.10.0-rc.5 AS musl\r\n    \r\n    # Stage 1: Use native image to copy files for authentication\r\n    FROM registry.scontain.com/workshop/java-cli-env-reader:96cebfdd2b7c823967d3b84ef11f6590e3db86418c93cabb28c4840ac1256d28 AS files\r\n    \r\n    # Stage 2: Use native image to find executables \r\n    #          stored in /executables.txt\r\n    \r\n    FROM registry.scontain.com/workshop/java-cli-env-reader:96cebfdd2b7c823967d3b84ef11f6590e3db86418c93cabb28c4840ac1256d28 AS collector\r\n    \r\n    USER root\r\n    \r\n    RUN find / \\( -path /proc -o -path /sys -o -path /dev \\) -prune -o -type f -executable -print >> /executables.txt && echo /sign_binaries.sh  >> /executables.txt\r\n    \r\n    # Stage 3: Final image with signing and authentication process\r\n    FROM registry.scontain.com/workshop/java-cli-env-reader:96cebfdd2b7c823967d3b84ef11f6590e3db86418c93cabb28c4840ac1256d28\r\n    \r\n    USER root\r\n    \r\n    # install scone components\r\n    \r\n    # Copy scone components from glibc stage\r\n    COPY --from=sconetools /packages/scone-common_amd64.deb /packages/scone-libc_amd64.deb /packages/scone-cli_amd64.deb /packages/scone-glibc-2.39-installer_amd64.deb /packages/ \r\n    \r\n    RUN apt update && \\\r\n        apt install -y /packages/scone-common_amd64.deb /packages/scone-libc_amd64.deb /packages/scone-cli_amd64.deb /packages/scone-glibc-2.39-installer_amd64.deb && \\\r\n        rm -rf /packages /var/lib/apt/lists/*\r\n    \r\n    \r\n    \r\n    # Copy executables list from the collector stage\r\n    COPY --from=collector /executables.txt /scone/policy/executables.txt\r\n    \r\n    # Environment variables\r\n    ENV SCONE_SYSLIBS=1\r\n    \r\n    # Set SCONE_MODE and SCONE_PRODUCTION\r\n    RUN export SCONE_MODE=auto\r\n    RUN export SCONE_PRODUCTION=0\r\n    \r\n    RUN echo /opt/java/openjdk/bin/java > /scone/policy/important.txt\r\n    \r\n    COPY --from=files / /rootvol\r\n    \r\n    RUN rm -rf /rootvol/etc/hosts\r\n    \r\n    # Make FSPF\r\n    RUN mkdir -p /fspf/file\r\n    RUN scone fspf create /fspf/file/fspf.pb\r\n    RUN scone fspf addr /fspf/file/fspf.pb / --authenticated --kernel /rootvol\r\n    RUN scone fspf addf /fspf/file/fspf.pb / /rootvol\r\n    RUN scone fspf encrypt /fspf/file/fspf.pb\r\n    \r\n    # Sign the binaries using scone-signer and write signed binaries to a file\r\n    COPY sign_binaries.sh sign_binaries.sh\r\n    RUN chmod +x sign_binaries.sh\r\n    # Print debug output in case of a signing failure to help diagnosing signing issues\r\n    RUN --mount=type=secret,id=sgx_signer_key,target=/identity.pem ./sign_binaries.sh > output.log 2>&1 || (cat output.log && false)\r\n    \r\n\u001b[90m[\u001b[0m2025-09-16T06:30:17Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Building registry.scontain.com/workshop/java-cli-env-reader:96cebfdd2b7c823967d3b84ef11f6590e3db86418c93cabb28c4840ac1256d28-scone: This process may take a little while...\r\n"]
[61.321042, "o", "\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Trying find the fspf...\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Found fspf line: #22 0.547 Encrypted file system protection file /fspf/file/fspf.pb AES-GCM tag: 4fe4dd287e6b38cc2fe36412adf5c510 key: 46dceec716ce4170f74a41fbf9d1c795c28f8a066c70d38c05840cfa1f40c7c5\r\n"]
[61.361307, "o", "\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Build done\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m lib_sconify\u001b[90m]\u001b[0m Generating policy: This process may take a little while...\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m gen_policy_lib\u001b[90m]\u001b[0m create_namespace_all policies/scone\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m gen_policy_lib\u001b[90m]\u001b[0m creating policies\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m gen_policy_lib\u001b[90m]\u001b[0m creating namespace policies\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m gen_policy_lib\u001b[90m]\u001b[0m Skipping creating session for namespace policies\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m gen_policy_lib\u001b[90m]\u001b[0m creating policies/scone\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m gen_policy_lib\u001b[90m]\u001b[0m creating namespace policies/scone\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:50Z \u001b[32mINFO \u001b[0m gen_policy_lib\u001b[90m]\u001b[0m Skipping creating session for namespace policies/scone\r\n"]
[62.245322, "o", "\u001b[90m[\u001b[0m2025-09-16T06:30:51Z \u001b[32mINFO \u001b[0m gen_policy_lib\u001b[90m]\u001b[0m YML File: binaries:\r\n    - /opt/scone/bin/rust-cli\r\n    - /opt/java/openjdk/bin/java\r\n    - /usr/bin/ngettext\r\n    - /usr/bin/gettext\r\n    - /usr/bin/envsubst\r\n    \r\n\u001b[90m[\u001b[0m2025-09-16T06:30:51Z \u001b[32mINFO \u001b[0m gen_policy_lib\u001b[90m]\u001b[0m Binaries= Binaries { binaries: [\"/opt/scone/bin/rust-cli\", \"/opt/java/openjdk/bin/java\", \"/usr/bin/ngettext\", \"/usr/bin/gettext\", \"/usr/bin/envsubst\"] }\r\n\u001b[90m[\u001b[0m2025-09-16T06:30:51Z \u001b[32mINFO \u001b[0m gen_policy_lib\u001b[90m]\u001b[0m Creating Dockerfile and building image\r\n"]
